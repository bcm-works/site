{% macro post(postDate, postReadingWords) %}
<ul class="post-info print-gray">
  <li class="post-date">
    <span class="icon fa-fw fa-solid fa-calendar-days"></span>
    <span class="value">{{ postDate | date('d LLL yyyy') }}</span>
  </li>
  <li class="post-words">
    <span class="icon fa-fw fa-solid fa-file-lines"></span>
    <span class="value">{{ postReadingWords }} words</span>
  </li>
</ul>
{% endmacro %}
