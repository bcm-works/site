<!DOCTYPE html>
<html lang="{{ SITE_LANG }}">
<head>

<title>{% if title %}{{ SITE_AUTHOR }} - {{ title }}{% else %}{{ SITE_AUTHOR }}{% endif %}</title>

<meta charset="utf-8">
<link rel="canonical" href="{{ SITE_URL }}{{ url }}">
<link rel="me" href="https://mastodon.social/@murty">
<meta name="handheldfriendly" content="true">
<meta name="mobileoptimized" content="480">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{% if theme %}{{ theme }}{% else %}#23c5b0{% endif %}">
<meta name="author" content="{{ SITE_AUTHOR }}" />
<meta name="description" content="{% if description %}{{ description }}{% else %}{{ SITE_FEED_DESC }}{% endif %}">
{% if date %}<meta property="article:published_time" content="{{ date | date('yyyy-MM-dd') }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ SITE_LANG }}">
<meta property="og:title" content="{% if title %}{{ SITE_AUTHOR }} - {{ title }}{% else %}{{ SITE_AUTHOR }}{% endif %}">
<meta property="og:url" content="{{ SITE_URL }}{{ url }}">
<meta name="og:description" content="{% if description %}{{ description }}{% else %}{{ SITE_FEED_DESC }}{% endif %}">
{% if photo_thumb_url %}<meta property="og:image" content="{{ SITE_URL }}{{ photo_thumb_url }}">
{% elif photo_url %}<meta property="og:image" content="{{ SITE_URL }}{{ photo_url }}">
{% else %}<meta property="og:image" content="{{ SITE_URL }}/images/brendan/profile/brendan_750.png">{% endif %}

<link rel="preload" href="/css/fonts/MDIO-Black.woff" as="font" crossOrigin="anonymous">
<link rel="preload" href="/css/fonts/MDIO-Regular.woff" as="font" crossOrigin="anonymous">
<link rel="preload" href="/css/bcm.min.css?v={{ SITE_BUILD_ID }}" as="style">
<link rel="stylesheet" href="/css/bcm.min.css?v={{ SITE_BUILD_ID }}">

<link rel="preload" href="/css/fonts/fontawesome/css/all.min.css?v={{ SITE_BUILD_ID }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="/css/fonts/fontawesome/css/all.min.css?v={{ SITE_BUILD_ID }}"></noscript>

<link rel="preload" href="/css/fonts/fontawesome/css/fontawesome.min.css?v={{ SITE_BUILD_ID }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="/css/fonts/fontawesome/css/fontawesome.min.css?v={{ SITE_BUILD_ID }}"></noscript>

<link rel="manifest" href="/manifest.json">
<link rel="alternate" title="{{ SITE_FEED_TITLE }}" type="application/json" href="/posts.json">
<link rel="alternate" title="{{ SITE_FEED_TITLE }}" type="application/rss+xml" href="/posts.rss">
<link rel="icon" sizes="192x192" href="/images/logos/android-chrome-192x192.png">
<link rel="icon" type="image/png" sizes="32x32" href="/images/logos/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/images/logos/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logos/apple-touch-icon.png">

{% if SITE_POSTHOG_ID %}<script>
// PostHog - https://posthog.com/
