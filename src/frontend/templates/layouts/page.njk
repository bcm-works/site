posthog.init('{{ SITE_POSTHOG_ID }}', {
  api_host: '{{ SITE_POSTHOG_API_HOST }}',
  ui_host: '{{ SITE_POSTHOG_UI_HOST }}',
  defaults: '2026-05-30',
  person_profiles: 'always',
})
