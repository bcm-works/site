<script type="speculationrules">
{
  "prerender": [
    {
      "source": "document",
      "where":
        {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/*.pdf" } },
            { "not": { "href_matches": "/api/*(/)" } },
            { "not": { "selector_matches": ".no-prerender" } },
            { "not": { "selector_matches": "[rel~=nofollow]" } }
          ]
        },
      "eagerness": "moderate"
    }
  ]
}
</script>
</head>
<body class="{% if body_class %}{{ body_class }} {% endif %}env-{{ SITE_ENV }} build-{{ SITE_BUILD_ID }}">
  <div class="layout-container">
    <div class="header-container">
      <header>
        <div class="header-title">
          <a href="/" class="site-link" title="Go to the home page">
            <img class="site-avatar" alt="" width="150" height="150" src="/images/brendan/profile/brendan_150.webp"/>
            <span class="site-name">{{ SITE_AUTHOR }}</span>
          </a>
        </div>

        <nav class="header-nav">
          <ul>
            <li class="nav-link{% if url == '/' %} active{% endif %}">
              <a href="/" title="Go to the home page">Home</a>
            </li>
            <li class="nav-link{% if '/posts/' in url %} active{% endif %}">
              <a href="/posts/" title="View all posts">Posts</a>
            </li>
            <li class="nav-link{% if '/tags/' in url %} active{% endif %}">
              <a href="/tags/" title="View all tags">Tags</a>
            </li>
          </ul>
        </nav>
      </header>
    </div>

    <main>
      <article class="content-body">
        <div class="print-header">
          <h1>{{ SITE_AUTHOR}}</h1>
          <p>{{ SITE_URL }}{{ url }}</p>
        </div>
        <div class="content-container">{{ content | safe }}</div>
      </article>
    </main>

    <footer>

    </footer>
  </div>
</body>
</html>
