FORGEJO____APP_NAME="Git"
FORGEJO____APP_SLOGAN="Git service"
FORGEJO____APP_DISPLAY_NAME_FORMAT="{APP_NAME}"
FORGEJO__database__DB_TYPE="sqlite3"
FORGEJO__database__PATH="${{FORGEJO__server__APP_DATA_PATH}}/gitea.db"
FORGEJO__database__SQLITE_JOURNAL_MODE="WAL"
FORGEJO__log__ROOT_PATH="${{FORGEJO__server__APP_DATA_PATH}}/logs"
FORGEJO__repository__ROOT="${{FORGEJO__server__APP_DATA_PATH}}/git/repositories"
FORGEJO__server__APP_DATA_PATH="/data/gitea"
FORGEJO__server__DOMAIN="${{RAILWAY_PUBLIC_DOMAIN}}"
FORGEJO__server__LFS_START_SERVER="false"
FORGEJO__server__LANDING_PAGE="explore"
FORGEJO__server__START_SSH_SERVER="false"
FORGEJO__server__DISABLE_SSH="true"
