### App config

APP_NAME=bcm-git
APP_ENV=local

BRAND_NAME=bcm-git

APP_URL=http://localhost:10880/
APP_DOMAIN=localhost:10880

# Dir paths on the host used as mapped volumes to the container
STORAGE_DIR_CUSTOM=/home/example/git/bcm/src/git/custom
STORAGE_DIR_GIT=/home/example/git/bcm/src/git/data/git
STORAGE_DIR_SSH=/home/example/git/bcm/src/git/data/ssh
STORAGE_DIR_POSTGRES=/home/example/git/bcm/src/git/data/postgres

### Gogs config

# Host Web port
WEB_PORT=10880

# Host SSH port
SSH_PORT=10022

# Container SSH port
SSH_LISTEN_PORT=2222

GOGS_CUSTOM=/etc/gogs
GOGS_SECURITY_SECRET_KEY=

GOGS_DATABASE_HOST=bcm-git-local-postgres:5432
GOGS_DATABASE_NAME=gogs
GOGS_DATABASE_USER=gogs
GOGS_DATABASE_PASSWORD=
