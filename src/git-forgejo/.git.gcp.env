#
#
# Git: GCP Cloud Run Secrets example file
#   - Initial manual setup required, follow steps in: src/git/README.md > Infrastructure
#   - After setting up the Cloud Run service, add a new Secret for each item below:
#     - Follow the navigation steps in each section to ensure it's added to the right area
#     - Set the name to the value before the '=' below, eg: APP_AUTHOR
#     - Set the value of each new Secret to suit your setup
#     - After manually adding these, you'll need to trigger a single manual deploy from GCP
#
#

APP_NAME=bcm-git
APP_ENV=production

APP_SLOGAN="Git service"
APP_DISPLAY_NAME_FORMAT="{APP_NAME}"

APP_THEME_LIST="bcm,forgejo-auto,forgejo-light,forgejo-dark"
APP_THEME_DEFAULT="bcm"

ROOT_URL=https://example.com/
PORT_WEB=3030
PORT_SSH=2022
