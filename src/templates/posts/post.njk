---
title: Posts
layout: layouts/page.layout.njk
body_class: page-post
---

<h2 data-pagefind-meta="title">{{ title }}</h2>

<p class="post-date">
  <span class="icon-post icon fa-fw fa-solid fa-calendar-days"></span>{{
    date | date('d LLL yyyy')
  }}
</p>

<ul class="tag-list">
  {% for tag in tags|sort %}
    {% if tag != "Post" %}
      <li>
        <a href="/tags/{{ tag }}/" title="View posts tagged with {{ tag }}">
          <span class="icon icon-tag fa-fw fa-solid fa-tag"></span>{{ tag }}
        </a>
      </li>
    {% endif %}
  {% endfor %}
</ul>

<div class="post-content">
  {{ content | safe }}
</div>
