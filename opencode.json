{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "autoupdate": true,
  "default_agent": "plan",
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "question": "allow",
    "webfetch": "allow",
    "grep": "allow",
    "glob": "allow",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "docs/AI-USE.md": "deny"
    },
    "bash": {
      "*": "ask",
      "cat": "allow",
      "ls": "allow",
      "tail": "allow",
      "go test": "allow",
      "GOCACHE=/tmp/gocache go test": "allow",
      "git status": "allow",
      "git log": "allow",
      "git commit": "deny",
      "git push": "deny",
    }
  }
}