{
  "name": "bcm-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nub ./tools/build.ts",
    "setup": "nub ./tools/setup.ts",
    "start": "nub ./tools/start.ts",
    "test": "echo 'Framework change not completed yet'",
    "new-post": "nub ./tools/new-post.ts",
    "release-notes": "nub ./tools/release-notes.ts",
    "docker-build": "nub ./tools/docker/docker-build.ts",
    "docker-start": "nub ./tools/docker/docker-start.ts",
    "docker-stop": "nub ./tools/docker/docker-stop.ts",
    "infra-setup": "nub ./tools/infra/infra-setup.ts",
    "deps-install": "nub ./tools/deps-install.ts",
    "deps-install-infra": "cd infra && nub install",
    "deps-update": "nub ./tools/deps-update.ts",
    "deps-update-infra": "cd infra && nub update",
    "lint": "tsc --noEmit --project tsconfig.json",
    "lint-deno": "deno lint && deno fmt"
  },
  "imports": {
    "#tool/*": "./tools/*.ts",
    "#be/*": "./src/backend/*.ts",
    "#fe/*": "./src/frontend/*.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@nubjs/types": "0.5.0",
    "chalk": "^5.6.2",
    "concurrently": "^10.0.3",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "nub@0.5.0",
  "engines": {
    "node": ">=26.5.0",
    "nub": ">=0.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  }
}
