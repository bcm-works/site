{
  "nodeModulesDir": "none",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "@/": "./src/",
    "@/tasks": "./src/tasks/",
    "@/be": "./src/backend/",
    "@/common": "./src/common/",
    "@/fe": "./src/frontend/",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.5.2",
    "@octokit/graphql": "npm:@octokit/graphql@^9.0.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.7",
    "@std/http": "jsr:@std/http@^1.1.2",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.1.2",
    "date-fns": "npm:date-fns@^4.4.0",
    "chalk": "npm:chalk@^5.6.2",
    "highlight": "npm:highlight.js@^11.11.1",
    "is_json/": "https://deno.land/x/is_json@v1.0.2/",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "posthog": "npm:posthog-node@^5.47.3"
  },
  "tasks": {
    "setup": {
      "description": "Run the setup script.",
      "command": "deno run --allow-all ./src/tasks/setup.ts"
    },
    "build": {
      "description": "Run the site build script.",
      "command": "deno run --allow-all ./src/tasks/build.ts"
    },
    "install": {
      "description": "Install third-party dependencies.",
      "command": "deno install --config ./deno.jsonc"
    },
    "update": {
      "description": "Update third-party dependencies.",
      "command": "deno outdated --update --compatible"
    },
    "deps": {
      "description": "Update all dependencies and commit the results.",
      "command": "deno task update && deno task infra-update && git add deno.jsonc deno.lock infra/deno.jsonc infra/deno.lock && git commit -m \"Update third-party dependencies\""
    },
    "start": {
      "description": "Start the web server.",
      "command": "deno run --quiet --allow-net --allow-read --allow-env ./src/backend/server.ts"
    },
    "test": {
      "description": "Run all Deno Test scripts in the 'src' directory.",
      "command": "deno test --quiet --allow-run=deno,docker --allow-env --allow-read --allow-net src"
    },
    "post": {
      "description": "Create a new post Markdown file.",
      "command": "deno run --allow-all ./src/tasks/post.ts"
    },
    "docker-build": {
      "description": "Build a local Docker Image",
      "command": "deno run --allow-all ./src/tasks/docker/docker-build.ts"
    },
    "docker-start": {
      "description": "Start a Docker Container using the local Docker Image",
      "command": "deno run --allow-all ./src/tasks/docker/docker-start.ts"
    },
    "docker-stop": {
      "description": "Start a Docker Container using the local Docker Image",
      "command": "deno run --allow-all ./src/tasks/docker/docker-stop.ts"
    },
    "lume": {
      "description": "Run a Lume command.",
      "command": "deno run --quiet -P=lume lume/cli.ts --config=src/frontend/lume.config.ts"
    },
    "lint": {
      "description": "Run Deno lint and fmt tools",
      "command": "deno --quiet lint && deno --quiet fmt"
    },
    "infra-setup": {
      "description": "Run the infra setup script.",
      "command": "cd infra && deno task setup"
    },
    "infra-install": {
      "description": "Run the infra install script.",
      "command": "cd infra && deno task install"
    },
    "infra-update": {
      "description": "Run the infra update script.",
      "command": "cd infra && deno task update"
    }
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "fmt": {
    "include": [
      "src/",
      "deno.jsonc"
    ],
    "lineWidth": 100,
    "useTabs": false,
    "indentWidth": 2,
    "semiColons": true
  },
  "lint": {
    "include": [
      "src/",
      "deno.jsonc"
    ],
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/lint.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "permissions": {
    "lume": {
      "read": true,
      "write": [
        "./"
      ],
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443"
      ],
      "net": [
        "0.0.0.0",
        "cdn.jsdelivr.net:443",
        "data.jsdelivr.com:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443",
        "registry.npmjs.org:443"
      ],
      "env": true,
      "run": true,
      "ffi": true,
      "sys": true
    }
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.28.0",
      "npm:fs-ext@2.0.0",
      "npm:chalk@5.6.2",
      "npm:purgecss@8.0.0",
      "npm:lightningcss-cli@1.32.0",
      "npm:date-fns@4.4.0"
    ]
  }
}
