#
#
# Environment: Deno Deploy
#
# Initial Setup
#   - Login to https://console.deno.com/
#   - Create (or navigate to) the Organisation, then App
#   - Setup/confirm the App configuration
#     - App Directory: (root)
#     - Framework preset: No Preset
#     - Install command: deno task install
#     - Build command: deno task build
#     - Runtime Configuration: Dynamic App
#     - Runtime Configuration > Entrypoint: src/backend/server.ts
#
# Add Environment Variables
#   - Navigate to your App in the Deno Deploy Console
#   - Click Settings in the sidebar
#   - Then add each item below in the Environment Variables section
#
#

SITE_ENV=production-deno
SITE_URL=https://xxxx.com
SITE_BUILD_DIR=build
SITE_PUBLIC_DIR=public
SITE_AUTHOR="Jane Doe"
SITE_TITLE="Public website for Jane Doe"
SITE_DESC="Jane writes about technology and the climate."
SITE_REPO=https://github.com/yyyy/zzzz
SITE_LANG=en-GB
SITE_TIMEZONE="Australia/Sydney"
SITE_FEED_TITLE="Posts by Jane Doe"
SITE_FEED_DESC="Jane writes about technology and the climate."
SITE_FEED_DEFAULT_TITLE="Post by Jane Doe"

# Add this as a "Secret" Variable Type in Deno Deploy.
SITE_POSTHOG_ID=aaabbbccc

SITE_POSTHOG_API_HOST=https://eu.posthog.com
SITE_POSTHOG_UI_HOST=https://eu.posthog.com

# This value will be updated each deployment, set the initial value to 1
SITE_BUILD_ID=1

# Setup a new GitHub Classic PAT
#   - From https://github.com/settings/tokens
#   - Add the 'read:user' scope only.
#
# Add this as a "Secret" Variable Type in Deno Deploy.
SITE_GITHUB_ID=dddeeefff
