{
  "nodeModulesDir": "auto",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "@railway/cli": "npm:@railway/cli@^5.30.2",
    "railway": "npm:railway@^3.7.0",
    "@types/node": "npm:@types/node@^26.1.2",
    "tsx": "npm:tsx@^4.23.1",
    "typescript": "npm:typescript@^5.9.3"
  },
  "tasks": {
    "pull": "deno x --yes --no-check npm:@railway/cli@^5.30.1 config pull --force",
    "plan": "deno x --yes --no-check npm:@railway/cli@^5.30.1 config plan",
    "apply": "deno x --yes --no-check npm:@railway/cli@^5.30.1 config apply",
    "export": "deno x --yes --no-check npm:@railway/cli@^5.30.1 status --json > railway.json",
    "start": "tsx index.ts",
    "setup": "cd .. && deno run --allow-all ./src/tasks/infra/infra-setup.ts",
    "install": {
      "description": "Install third-party dependencies.",
      "command": "deno install --config ./deno.jsonc"
    },
    "update": {
      "description": "Update third-party dependencies.",
      "command": "deno outdated --update --compatible"
    },
  },
  "allowScripts": {
    "allow": ["npm:@railway/cli@5.30.2"],
    "deny": []
  }
}
