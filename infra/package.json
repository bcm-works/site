{
  "name": "bcm-site-infra",
  "private": true,
  "type": "module",
  "scripts": {
    "pull": "railway config pull --force",
    "plan": "railway config plan",
    "apply": "railway config apply",
    "export": "railway status --json > railway.json",
    "start": "tsx index.ts"
  },
  "dependencies": {
    "railway": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "nub@0.5.0",
  "engines": {
    "node": ">=26.5.0",
    "nub": ">=0.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  }
}
