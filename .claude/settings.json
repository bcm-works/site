{
  "theme": "auto",
  "feedbackSurveyRate": 0,
  "outputStyle": "Proactive",
  "respectGitignore": true,
  "spinnerTipsEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(head*)",
      "Bash(less*)",
      "Bash(ls*)",
      "Bash(tail*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(nub run build)",
      "Bash(nub run start)",
      "Bash(nub run test)"
    ],
    "deny": [
      "Read(.env)",
      "Read(src/infra/.env)",
      "Bash(railway)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ]
  }
}