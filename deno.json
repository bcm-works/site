{
  "nodeModulesDir": "none",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "$be/": "./app/backend/",
    "$fe/": "./app/frontend/",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.7.2",
    "@octokit/graphql": "npm:@octokit/graphql@^9.0.5",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "date-fns": "npm:date-fns@^4.4.0",
    "chalk": "npm:chalk@^6",
    "highlight": "npm:highlight.js@^11.12.0",
    "is_json/": "https://deno.land/x/is_json@v1.0.2/",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.1/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "posthog": "npm:posthog-node@^5.52.4",
    "railway": "npm:railway@^3.11.0",
    "react": "npm:react@^19.3.0"
  },
  "tasks": {
    "setup": {
      "description": "Run the setup script.",
      "command": "./task setup"
    },
    "build": {
      "description": "Run the site build process.",
      "command": "deno run --allow-all ./app/backend/build.ts"
    },
    "install": {
      "description": "Install Deno dependencies.",
      "command": "deno install --quiet && cd ./app/frontend/app && deno task install"
    },
    "update": {
      "description": "Update Deno dependencies.",
      "command": "deno outdated --update --compatible && cd ./app/frontend/app && deno task update"
    },
    "deps": {
      "description": "Update Deno and Go dependencies.",
      "command": "./task deps"
    },
    "start": {
      "description": "Start the web server after installing and building.",
      "command": "./task start"
    },
    "serve": {
      "description": "Start the web server.",
      "command": "deno serve --allow-read --allow-env --allow-net ./app/backend/server.ts"
    },
    "test": {
      "description": "Run the Deno test suite.",
      "command": "deno test --allow-all --clean --coverage=.coverage --coverage-threshold=85 app"
    },
    "lume": {
      "description": "Run the Lume site build process.",
      "command": "TZ=Australia/Sydney LUME_LOGS=error deno run --allow-all lume/cli.ts --config=app/frontend/lume.config.ts"
    },
    "cli:build": {
      "description": "Run the CLI build process.",
      "command": "bash ./cli/build.sh"
    },
    "check": {
      "description": "Run Deno code checks.",
      "command": "deno --quiet lint && deno --quiet fmt && deno --quiet check && deno --quiet check --config=app/frontend/app/deno.json app/frontend/app/main.tsx"
    },
    "infra:login": {
      "description": "Login to the Railway CLI and link your infra project.",
      "command": "railway login && railway link"
    },
    "infra:pull": {
      "description": "Pull down Railway infra config.",
      "command": "railway config pull --force && mv .railway/railway.ts app/backend/infra.railway.ts"
    },
    "infra:plan": {
      "description": "Check how local infra config changes affect Railway infra.",
      "command": "railway config plan --file app/backend/infra.railway.ts"
    },
    "infra:apply": {
      "description": "Apply local infra config changes to Railway infra.",
      "command": "railway config apply --file app/backend/infra.railway.ts"
    }
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts",
      "npm:@types/react@19.3.0"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume",
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true
  },
  "fmt": {
    "include": [
      "app/backend/",
      "app/frontend/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      "app/backend/",
      "app/frontend/",
      "deno.json"
    ],
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/lint.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.28.2",
      "npm:chalk@6.0.0",
      "npm:lightningcss-cli@1.32.0",
      "npm:date-fns@4.4.0"
    ]
  },
  "exclude": [
    "node_modules/",
    ".delta/",
    ".github/",
    ".prototypes/",
    ".zed/",
    "build/",
    "public/",
    "cli/",
    "app/backend/infra.railway.ts",
    "app/frontend/app/",
    "app/frontend/components/github.tsx"
  ]
}
