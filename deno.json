{
  "nodeModulesDir": "none",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "@/": "./src/",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.5.2",
    "@octokit/graphql": "npm:@octokit/graphql@^9.0.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "date-fns": "npm:date-fns@^4.4.0",
    "chalk": "npm:chalk@^6.0.0",
    "highlight": "npm:highlight.js@^11.12.0",
    "is_json/": "https://deno.land/x/is_json@v1.0.2/",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "posthog": "npm:posthog-node@^5.48.2"
  },
  "tasks": {
    "setup": {
      "description": "Run the setup script.",
      "command": "./task setup"
    },
    "build": {
      "description": "Run the site build process.",
      "command": "deno run --allow-all ./src/backend/build.ts"
    },
    "install": {
      "description": "Install Deno dependencies.",
      "command": "deno install --quiet"
    },
    "update": {
      "description": "Update Deno dependencies.",
      "command": "deno outdated --update --compatible"
    },
    "deps": {
      "description": "Update Deno and Go dependencies.",
      "command": "./task deps"
    },
    "start": {
      "description": "Start the web server after installing and building.",
      "command": "./task start"
    },
    "serve": {
      "description": "Start the web server.",
      "command": "deno serve --allow-read --allow-env --allow-net ./src/backend/server.ts"
    },
    "test": {
      "description": "Run the Deno test suite.",
      "command": "deno test --allow-all --clean --coverage=coverage --coverage-threshold=85 src"
    },
    "lume": {
      "description": "Run the Lume site build process.",
      "command": "TZ=Australia/Sydney LUME_LOGS=error deno run -P=lume lume/cli.ts --config=src/frontend/lume.config.ts"
    },
    "check": {
      "description": "Run Deno code checks.",
      "command": "deno --quiet lint && deno --quiet fmt && deno --quiet check"
    }
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume",
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "fmt": {
    "include": [
      "src/backend/",
      "src/frontend/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      "src/backend/",
      "src/frontend/",
      "deno.json"
    ],
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/lint.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "permissions": {
    "lume": {
      "read": true,
      "write": [
        "./"
      ],
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443"
      ],
      "net": [
        "0.0.0.0",
        "cdn.jsdelivr.net:443",
        "data.jsdelivr.com:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443",
        "registry.npmjs.org:443"
      ],
      "env": true,
      "run": true,
      "ffi": true,
      "sys": true
    }
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.28.0",
      "npm:fs-ext@2.0.0",
      "npm:chalk@5.6.2",
      "npm:purgecss@8.0.0",
      "npm:lightningcss-cli@1.32.0",
      "npm:date-fns@4.4.0"
    ]
  },
  "exclude": [
    "node_modules/",
    "src/cli/"
  ]
}
