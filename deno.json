{
  "nodeModulesDir": "none",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "@/": "./src/",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.5.2",
    "@octokit/graphql": "npm:@octokit/graphql@^9.0.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "date-fns": "npm:date-fns@^4.4.0",
    "chalk": "npm:chalk@^5.6.2",
    "highlight": "npm:highlight.js@^11.11.1",
    "is_json/": "https://deno.land/x/is_json@v1.0.2/",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "posthog": "npm:posthog-node@^5.47.7"
  },
  "tasks": {
    "setup": {
      "description": "Run the setup script.",
      "command": "deno run --allow-all ./src/tasks/setup.ts"
    },
    "build": {
      "description": "Run the site build script.",
      "command": "deno run --allow-all ./src/tasks/build.ts"
    },
    "install": {
      "description": "Install third-party dependencies.",
      "command": "deno install --quiet"
    },
    "update": {
      "description": "Update third-party dependencies.",
      "command": "deno outdated --update --compatible"
    },
    "deps": {
      "description": "Update all dependencies and commit the results.",
      "command": "deno task update && git add deno.json deno.lock && git commit -m \"Update third-party dependencies\" || true"
    },
    "start": {
      "description": "Start the web server after installing and building.",
      "command": "deno task serve",
      "dependencies": ["install", "build"]
    },
    "serve": {
      "description": "Start the server.",
      "command": "deno serve --allow-read --allow-env --allow-net ./src/backend/server.ts"
    },
    "test": {
      "description": "Run all Deno Test scripts in the 'src' directory.",
      "command": "deno test --quiet --allow-run=deno --allow-env --allow-read --allow-net src",
      "dependencies": ["install", "build"]
    },
    "post": {
      "description": "Create a new post Markdown file.",
      "command": "deno run --allow-all ./src/tasks/post.ts"
    },
    "lume": {
      "description": "Run a Lume command.",
      "command": "deno run --quiet -P=lume lume/cli.ts --config=src/frontend/lume.config.ts"
    },
    "check": {
      "description": "Run Deno code checks.",
      "command": "deno --quiet lint && deno --quiet fmt && deno --quiet check"
    },
    "build-cli": {
      "description": "Create the './tasks' binary from '/src/tasks/cli/task.cli.ts'.",
      "command": "rm -rf ./task && deno compile --allow-all --output ./task src/tasks/cli/task.cli.ts"
    },
    "list": {
      "description": "List all available commands.",
      "command": "deno task"
    }
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "deploy": {
    "org": "murty",
    "app": "bcm-site",
    "install": "deno task install",
    "build": "deno task build",
    "runtime": {
      "mode": "dynamic",
      "entrypoint": "src/backend/server.ts"
    }
  },
  "fmt": {
    "include": [
      "src/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      "src/",
      "deno.json"
    ],
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/lint.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "permissions": {
    "lume": {
      "read": true,
      "write": [
        "./"
      ],
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443"
      ],
      "net": [
        "0.0.0.0",
        "cdn.jsdelivr.net:443",
        "data.jsdelivr.com:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443",
        "registry.npmjs.org:443"
      ],
      "env": true,
      "run": true,
      "ffi": true,
      "sys": true
    }
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.28.0",
      "npm:fs-ext@2.0.0",
      "npm:chalk@5.6.2",
      "npm:purgecss@8.0.0",
      "npm:lightningcss-cli@1.32.0",
      "npm:date-fns@4.4.0"
    ]
  },
  "exclude": [
    "infra/",
    "node_modules/"
  ]
}
