{
  "nodeModulesDir": "auto",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "$tools/": "./tools/",
    "$app/": "./app/",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.8.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "date-fns": "npm:date-fns@^4.4.0",
    "chalk": "npm:chalk@^6.0.1",
    "highlight": "npm:highlight.js@^11.12.0",
    "is_json/": "https://deno.land/x/is_json@v1.0.2/",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.1/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "wrangler": "npm:wrangler@^4.162.0"
  },
  "tasks": {
    "setup": {
      "description": "Run the setup script.",
      "command": "./task setup"
    },
    "build": {
      "description": "Run the site build process.",
      "command": "deno run --allow-all ./tools/build.ts"
    },
    "install": {
      "description": "Install Deno dependencies.",
      "command": "deno install --quiet"
    },
    "deps": {
      "description": "Update Deno and Go dependencies.",
      "command": "deno task deps-deno && deno task deps-go"
    },
    "deps-deno": {
      "description": "Update Deno dependencies.",
      "command": "deno outdated --update --compatible"
    },
    "deps-go": {
      "description": "Update Deno and Go dependencies.",
      "command": "cd cli && asdf exec go get -u -t ./... && asdf exec go mod tidy"
    },
    "start": {
      "description": "Start the web server after installing and building.",
      "command": "./task start"
    },
    "serve": {
      "description": "Serve the built static frontend locally.",
      "command": "deno run --allow-read --allow-net jsr:@std/http/file-server public"
    },
    "test": {
      "description": "Run Deno tests.",
      "command": "deno test --allow-all --clean --coverage=.coverage --coverage-threshold=85 app tools"
    },
    "test-go": {
      "description": "Run Go tests.",
      "command": "cd cli && asdf exec go test -v"
    },
    "lume": {
      "description": "Run the Lume site build process.",
      "command": "TZ=Australia/Sydney LUME_LOGS=error deno run --allow-all lume/cli.ts --config=app/lume.config.ts"
    },
    "check": {
      "description": "Run code linting and formatting tools.",
      "command": "deno task check-deno && deno task check-go"
    },
    "check-deno": {
      "description": "Run Deno code linting and formatting tools.",
      "command": "deno lint && deno fmt"
    },
    "check-go": {
      "description": "Run Go code linting and formatting tools.",
      "command": "cd cli && asdf exec go fmt ./..."
    },
    "build-cli": {
      "description": "Run the CLI build process.",
      "command": "bash ./cli/build.sh"
    },
    "ai": {
      "description": "Run OpenCode using project specific config.",
      "command": "bash ./.opencode/start.sh"
    }
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume",
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true
  },
  "fmt": {
    "include": [
      ".opencode/",
      "tools/",
      "app/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      ".opencode/",
      "tools/",
      "app/",
      "deno.json"
    ],
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.1/lint.ts"
    ]
  },
  "allowScripts": {
    "allow": ["npm:esbuild@0.28.2", "npm:workerd@1.20261113.1"],
    "deny": ["npm:chalk@6.0.0", "npm:date-fns@4.4.0", "npm:lightningcss-cli@1.32.0"]
  },
  "exclude": [
    "node_modules/",
    ".github/",
    "build/",
    "public/",
    "cli/"
  ]
}
