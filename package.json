{
  "name": "bcm-site",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "nub ./tools/setup.ts",
    "start": "",
    "lint": "tsc --noEmit --project tsconfig.json",
    "ai-sync": "aspens doc sync",
    "docker-build": "nub ./tools/docker/docker-build.ts",
    "docker-start": "nub ./tools/docker/docker-start.ts",
    "docker-stop": "nub ./tools/docker/docker-stop.ts"
  },
  "imports": {
    "#tools/*": "./tools/*.ts",
    "#helpers/*": "./tools/helpers/*.ts"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7"
  },
  "packageManager": "nub@0.5.0",
  "engines": {
    "node": ">=26.5.0",
    "nub": ">=0.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@nubjs/types": "0.5.0",
    "chalk": "^5.6.2"
  }
